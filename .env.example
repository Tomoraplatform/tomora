# Every variable the code reads. No real values live here.
#
# On a new machine, do not fill this in by hand. Pull the real values from
# Vercel, which is the only copy guaranteed to be current:
#
#   npx vercel link && npx vercel env pull .env.local
#
# `.env*.local` is gitignored and must stay that way.

# ---- Supabase (required, nothing runs without these) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Paystack (required for any payment: subscriptions, orders, donations, courses) ----
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ---- App ----
NEXT_PUBLIC_APP_DOMAIN=tomora.com.ng
# Absolute origin used in emails and callbacks. Falls back to APP_DOMAIN.
NEXT_PUBLIC_SITE_URL=

# ---- Email (Resend). Unset means transactional email is skipped, not failed. ----
RESEND_API_KEY=
EMAIL_FROM=
SUPPORT_EMAIL=

# ---- Tomora Live, WhatsApp commerce ----
# All six together or none. Live stays dormant while any is unset.
# Webhook: https://www.tomora.com.ng/api/webhooks/whatsapp
# WHATSAPP_VERIFY_TOKEN must match the string entered in the Meta dashboard.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Also guards the scheduled Live job, so set it with the rest.
CRON_SECRET=

# ---- TikTok pixel ----
# The pixel id runs in the browser on its own. The access token is the server
# side Events API half, which is what deduplicates and attributes conversions.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=
# Set only while testing against TikTok's event debugger. Leave blank in production.
TIKTOK_TEST_EVENT_CODE=

# ---- AI features (optional, each degrades quietly when unset) ----
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=

# ---- Seed and signing tokens for one off admin endpoints ----
ACADEMY_SEED_TOKEN=
RESOURCE_SEED_TOKEN=
RESOURCE_TOKEN_SECRET=

# ---- Not read by the code today. Kept because the README still lists them. ----
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
NAMECHEAP_API_KEY=
